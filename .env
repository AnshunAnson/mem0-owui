LOG_LEVEL=INFO
SQLITE_PATH=./data/memory_governance.db
DISPATCHER_INTERVAL_SECONDS=10
DEDUPE_WINDOW_SECONDS=300
MAX_RETRY_COUNT=5
RETRY_BACKOFF_SECONDS=30

REDIS_URL=redis://redis:6379/0
MAIN_QUEUE_NAME=memory-events
REPAIR_QUEUE_NAME=memory-repair

LLM_API_BASE=http://host.docker.internal:1234/v1
LLM_API_KEY=sk-local
# Derived env for mem0/openai SDK paths.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=sk-local
LLM_MODEL=qwen3.5-9b
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_MODEL_DIMS=1024
LLM_TIMEOUT_SECONDS=30

QDRANT_HOST=qdrant
QDRANT_PORT=6333
NEO4J_URL=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

RETRIEVAL_TIMEOUT_MS=600
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_MEMORIES=6
RETRIEVAL_MAX_CHARS_PER_MEMORY=300
RETRIEVAL_MAX_TOTAL_CHARS=1200
MEMORY_CONFIDENCE_THRESHOLD=0.7

REDIS_LOCK_TIMEOUT_SECONDS=60
REDIS_LOCK_BLOCKING_TIMEOUT_SECONDS=10
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_PORT=8081
